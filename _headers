# Cloudflare Pages / Netlify header rules.
#
# Two of these are not optional:
#
#  - the .pmtiles archive is read with HTTP Range requests, and a host that
#    answers 200 with the whole 19 MB file for every pan is not serving a map,
#    it is serving a download. Every host worth using does ranges by default;
#    this only makes the intent explicit.
#  - .mjs must arrive as JavaScript. MapLibre's worker is a module script and
#    a browser refuses one served as application/octet-stream — the map then
#    draws a blank sheet of paper with no error anywhere.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

/map/shanghai.pmtiles
  Accept-Ranges: bytes
  Cache-Control: public, max-age=604800

/map/lib/*.mjs
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/map/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Paid content. Never let anything keep a copy.
/api/*
  Cache-Control: private, no-store
